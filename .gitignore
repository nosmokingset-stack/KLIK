# Public allowlist. Local originals, unlicensed photos and review artifacts stay off GitHub.
/*
!/.gitignore
!/README.md
!/INSTALL.md
!/CHANGELOG.md
!/PUBLICATION.md
!/VERIFY-V1.1.md
!/assets.config.json
!/asset-links.json
!/build.cjs
!/serve.cjs
!/body.html
!/site.css
!/site.js
!/index.html
!/template.xml
!/public-files.txt
!/assets/
/assets/*
!/assets/logo/
/assets/logo/*
!/assets/logo/klik-approved.webp
!/assets/products/
/assets/products/*
!/assets/products/*.webp
!/assets/comparisons/
/assets/comparisons/*
!/assets/comparisons/*.webp
!/assets/comparisons/README.md
!/assets/water-stations/
/assets/water-stations/*
!/assets/water-stations/PUBLIC-STATUS.md
!/assets/decor/
!/assets/icons/
!/assets/animations/
!/preview/
/preview/*
!/preview/index.html
!/preview/desktop-v1.1.png
!/preview/mobile-v1.1.png
!/preview/public-links-report.json
!/references/
/references/*
!/references/README.md
